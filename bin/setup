#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args, rebundle: false)
  if rebundle
    # On a freshly created devcontainer, `bundle install` has occasionally
    # finished compiling a gem's native extension (e.g. bigdecimal/json right
    # after a version bump) just *after* Bundler decided the gem was usable,
    # so it gets marked "missing extensions" and excluded. `bundle install`
    # itself reports success in that case; the failure only shows up later,
    # e.g. mid `db:prepare` below. When rebundle:true, we force the same
    # activation check Rails will do, right here, so we can retry before moving on.
    system("bundle", "exec", "ruby", "-e", "") or begin
      puts "\n== Possible issue with gems installed with broken native extensions, retrying =="
      system! "bundle install"
    end
  end
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  # Always run `bundle install` rather than gating on `bundle check`: `bundle
  # check` only verifies the dependency graph resolves, it does not detect
  # gems whose native extensions failed to build (e.g. after a gem version
  # bump), which then blow up later when Rails actually requires them.
  system! "bundle install"

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end
  
  puts "\n== Installing JavaScript dependencies =="
  system! "npm install"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare", rebundle: true
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
