{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noImplicitAny": false,
    /*
     * Unused locals/parameters are enforced by ESLint
     * (@typescript-eslint/no-unused-vars, an error in tseslint's recommended
     * config, and CI runs lint) rather than by tsc.
     *
     * They cannot be enforced here because several @pretextbook packages ship
     * raw TypeScript as their entry point ("types": "./src/index.ts", no dist),
     * so `tsc -b` compiles a dependency's own source under *our* options — and
     * an unused import in a published package then fails our build, with no fix
     * available on this side. ESLint only looks at our source, so the check
     * lands exactly where it can be acted on.
     */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
