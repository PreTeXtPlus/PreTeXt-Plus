<h1 style="font-size: 22px; font-weight: bold; margin: 0 0 16px;">
  Subscription Digest
</h1>
<p style="margin: 0 0 16px; color: #51545E;">
  A summary of subscription activity over the last day.
</p>

<% if @new_charges.any? %>
  <h2 style="font-size: 16px; font-weight: bold; margin: 0 0 8px;">New paying subscriptions</h2>
  <% @new_charges.each do |charge| %>
    <% subscription = charge.subscription %>
    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin-bottom: 24px;">
      <tbody>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">User</td>
          <td style="padding: 8px 12px; font-size: 14px;">
            <% if subscription.user %>
              <%= subscription.user.name %> &lt;<%= subscription.user.email %>&gt;
            <% else %>
              <span style="color: #6B6E76;">—</span>
            <% end %>
          </td>
        </tr>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Plan</td>
          <td style="padding: 8px 12px; font-size: 14px;">
            <%= subscription.type&.name || subscription.processor_plan %><%= " (invoiced)" if subscription.invoiced? %>
          </td>
        </tr>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Billing</td>
          <td style="padding: 8px 12px; font-size: 14px;">
            <% interval = subscription.type&.recurrence %>
            <% if interval == "year" %>
              Annual
            <% elsif interval == "month" %>
              Monthly
            <% else %>
              <span style="color: #6B6E76;">—</span>
            <% end %>
          </td>
        </tr>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Amount</td>
          <td style="padding: 8px 12px; font-size: 14px;"><%= Pay::Currency.format(charge.amount, currency: charge.currency) %></td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>

<% if @canceled_subscriptions.any? %>
  <h2 style="font-size: 16px; font-weight: bold; margin: 0 0 8px;">Canceled subscriptions</h2>
  <% @canceled_subscriptions.each do |subscription| %>
    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin-bottom: 24px;">
      <tbody>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">User</td>
          <td style="padding: 8px 12px; font-size: 14px;">
            <% if subscription.user %>
              <%= subscription.user.name %> &lt;<%= subscription.user.email %>&gt;
            <% else %>
              <span style="color: #6B6E76;">—</span>
            <% end %>
          </td>
        </tr>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Plan</td>
          <td style="padding: 8px 12px; font-size: 14px;"><%= subscription.type&.name || subscription.processor_plan %></td>
        </tr>
        <tr style="border-bottom: 1px solid #E2E2E2;">
          <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Canceled</td>
          <td style="padding: 8px 12px; font-size: 14px;"><%= subscription.updated_at.to_fs(:long) %></td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>
