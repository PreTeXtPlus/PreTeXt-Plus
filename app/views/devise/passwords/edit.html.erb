<% content_for :title, "Reset Your Password" %>
<% content_for :heading, "Reset your password" %>

<%= form_with(model: resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, data: { turbo: false }) do |form| %>
  <%= form.hidden_field :reset_password_token %>

  <div class="my-5">
    <%= form.label :password, class: "text-sm font-semibold text-gray-800" do %>
        Choose a new secure password
    <% end %>
    <%= form.password_field :password, required: true, autofocus: true, placeholder: "Enter new password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit "Save new password", class: "#{button_classes(color: "blue")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
  </div>
<% end %>
