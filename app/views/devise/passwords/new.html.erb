<% content_for :title, "Password Reset" %>
<% content_for :heading, "Forgot your password?" %>

<%= form_with(model: resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, data: { turbo: false }) do |form| %>
  <div class="my-5">
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit "Email reset instructions", class: "#{button_classes(color: "blue")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
  </div>
<% end %>
