<%# The drawer panel itself, without the frame around it. Rendered two ways: into the
    dashboard's "drawer" frame by the ⋯ on a row, and inline by projects/show when the
    request was a full-page visit to a target URL. Takes locals rather than ivars so both
    callers can supply them.

    Always rendered from a real request, including when a finished build refreshes it:
    that broadcast is a signal, and the frame around this panel re-fetches the content
    itself (see Target#broadcast_drawer). Which is what lets this keep using `request`,
    and lets the log and history below run to any size at all.

    The panel carries the id that broadcast aims at -- on the panel rather than the
    overlay, so that the id says *which* target's drawer is open. %>
<div data-controller="drawer" class="fixed inset-0 z-30 flex justify-end">
  <div class="absolute inset-0 bg-gray-900/30" data-action="click->drawer#close"></div>

  <%# data-drawer-url is the panel saying where it came from, so a reload_drawer broadcast
      can put the frame's src back if something has re-rendered the frame without one.
      Nothing should now -- both drawer re-renders go through turbo_stream.update, which
      leaves the frame element alone -- but a drawer that silently stops live-updating is
      a hard thing to notice, and this makes the recovery automatic. %>
  <div id="<%= dom_id(target, :drawer) %>"
       data-drawer-url="<%= project_target_path(project, target) %>"
       role="dialog" aria-modal="true" aria-label="<%= target.name %> details"
       class="relative flex h-full w-full max-w-xl flex-col overflow-y-auto bg-white shadow-xl">

    <div class="flex items-start justify-between gap-4 border-b border-gray-200 p-5">
      <div>
        <h2 class="text-lg font-semibold"><%= target.name %></h2>
        <p class="text-xs text-gray-500"><%= target.kind_label %> · <span class="font-mono"><%= target.slug %></span></p>
      </div>
      <div class="flex items-center gap-2">
        <%# The one action the header offers, whichever way round it is: start the build
            that isn't running, or stop the one that is. _top for the same reason as the
            settings buttons below -- the redirect carries a flash, which a frame swap
            would swallow along with the "it may still be running" case. %>
        <% if target.state == :building %>
          <%= button_to "Cancel build", cancel_project_build_path(project, target.latest_build),
                form: { data: { turbo_frame: "_top" } },
                class: "cursor-pointer rounded-md border border-gray-300 px-2.5 py-1.5 text-sm hover:bg-gray-50",
                data: { turbo_confirm: "Stop this build? Nothing that is already published changes." } %>
        <% else %>
          <%= button_to "Rebuild", project_target_builds_path(project, target),
                class: "cursor-pointer rounded-md border border-gray-300 px-2.5 py-1.5 text-sm hover:bg-gray-50" %>
        <% end %>
        <button type="button" data-action="drawer#close" aria-label="Close"
                class="cursor-pointer rounded-md px-2.5 py-1.5 text-sm text-gray-500 hover:bg-gray-100">✕</button>
      </div>
    </div>

    <div class="space-y-2 border-b border-gray-200 p-5 text-sm">
      <div class="flex gap-3">
        <span class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-gray-500">State</span>
        <%= target_state_pill(target.state) %>
      </div>
      <div class="flex gap-3">
        <span class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-gray-500">Live now</span>
        <span>
          <% if target.current_build %>
            Build from <%= target.last_built_at.to_fs(:long) %>
          <% else %>
            Nothing built yet
          <% end %>
        </span>
      </div>
      <div class="flex gap-3">
        <span class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-gray-500">Last try</span>
        <span>
          <%= target.latest_build ? "#{target.latest_build.created_at.to_fs(:long)} — #{target.latest_build.status.humanize.downcase}" : "—" %>
        </span>
      </div>

      <%# One step back, honestly labelled: restoring *is* deleting the newest successful
          build, at which point the previous one is what readers get. _top for the same
          reason as rename and remove below -- the redirect re-renders the dashboard with
          the drawer open, so both the row and this panel show the restored build. %>
      <% if (previous = target.previous_successful_build) %>
        <div class="pt-1">
          <%= button_to "Restore previous build", revert_project_target_path(project, target),
                method: :patch, form: { data: { turbo_frame: "_top" } },
                class: "cursor-pointer rounded-md border border-gray-300 px-2.5 py-1.5 text-sm hover:bg-gray-50",
                data: { turbo_confirm: "Go back to the build from #{previous.created_at.to_fs(:long)}? " \
                                       "The current build will be deleted." } %>
          <p class="mt-1 text-xs text-gray-500">
            Deletes the current build and goes back to the one from
            <%= previous.created_at.to_fs(:long) %>. Only one earlier build is kept.
          </p>
        </div>
      <% end %>
    </div>

    <div class="border-b border-gray-200 p-5">
      <p class="font-mono text-xs uppercase tracking-wider text-gray-500">Public link</p>
      <% if target.published? %>
        <%# The URL is what an author came here for, so it gets the field and the primary
            action; unpublishing sits below, away from the thing being copied. %>
        <div data-controller="clipboard">
          <div class="mt-2 flex items-center gap-2 rounded-md border border-gray-200 bg-gray-50 p-2">
            <code data-clipboard-target="source" class="flex-1 truncate text-xs"><%= target_public_url(target, base_url: request.base_url) %></code>
            <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
                    class="cursor-pointer rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium whitespace-nowrap hover:bg-gray-50">
              Copy
            </button>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500">
          Anyone with this link can read it. It always serves the most recent successful
          build, so a failed rebuild leaves it untouched. Unpublishing breaks it immediately.
        </p>
        <%= button_to "Unpublish", publish_project_target_path(project, target),
              method: :patch, params: { published: false },
              class: "mt-3 cursor-pointer rounded-md border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50" %>
      <% elsif target.current_build.present? %>
        <%= button_to "Publish this output", publish_project_target_path(project, target),
              method: :patch, params: { published: true },
              class: "mt-2 cursor-pointer rounded-md border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50" %>
        <p class="mt-2 text-xs text-gray-500">Publishing does not start a build — it exposes the one already built.</p>
      <% else %>
        <p class="mt-2 text-sm text-gray-600">Build this output before publishing it.</p>
      <% end %>
    </div>

    <% if (log = target.latest_build&.log).present? %>
      <div class="border-b border-gray-200 p-5">
        <p class="font-mono text-xs uppercase tracking-wider text-gray-500">Build log</p>
        <pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-gray-900 p-3 text-xs text-gray-100 whitespace-pre-wrap"><%= log %></pre>
      </div>
    <% end %>

    <div class="border-b border-gray-200 p-5">
      <p class="font-mono text-xs uppercase tracking-wider text-gray-500">History</p>
      <% builds = target.recent_builds %>
      <% if builds.any? %>
        <table class="mt-2 w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <% builds.each do |build| %>
              <tr>
                <td class="py-2 pr-3 tabular-nums text-gray-600"><%= build.created_at.to_fs(:short) %></td>
                <td class="py-2 pr-3"><%= build_history_pill(build, target) %></td>
                <td class="py-2 text-right">
                  <%# Same rule as the dashboard row: only offer to open what is worth
                      opening, and hand over the artifact itself otherwise. %>
                  <% if build.success? && build.entry_path.present? %>
                    <% if target.site? || target.viewable? %>
                      <%= link_to target.site? ? "Preview" : "Open", build_file_path(build, build.entry_path),
                            class: "text-indigo-700 hover:underline", target: "_blank", rel: "noopener",
                            data: { turbo: false } %>
                    <% else %>
                      <%= link_to "Download", build_file_path(build, build.entry_path, disposition: "attachment"),
                            class: "text-indigo-700 hover:underline", data: { turbo: false } %>
                    <% end %>
                  <% end %>
                  <%= link_to "Log", project_build_path(project, build),
                        class: "ml-3 text-indigo-700 hover:underline", data: { turbo_frame: "_top" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="mt-2 text-sm text-gray-600">No builds yet.</p>
      <% end %>
    </div>

    <div class="p-5">
      <p class="font-mono text-xs uppercase tracking-wider text-gray-500">Settings</p>
      <%# _top, because both of these redirect to the dashboard: followed inside the frame
          the redirect would be absorbed by the dashboard's own empty "drawer" frame,
          closing the drawer while the row behind it still showed the old name -- or the
          removed output -- until a reload. %>
      <%= form_with model: [ project, target ], data: { turbo_frame: "_top" },
            class: "mt-2 flex flex-wrap items-end gap-3" do |form| %>
        <div>
          <%= form.label :name, "Name", class: "block text-xs text-gray-600" %>
          <%= form.text_field :name, required: true,
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        </div>
        <%= form.submit "Save", class: "cursor-pointer rounded-md border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50" %>
      <% end %>

      <%# The slug is fixed at creation on purpose, and this is the one place an author
          can find out that renaming is safe. %>
      <p class="mt-2 text-xs text-gray-500">
        Renaming changes only what you see here. This output stays
        <span class="font-mono"><%= target.slug %></span> in the public link and in
        <code>project.ptx</code>, so a link you have already shared keeps working.
      </p>

      <%= button_to "Remove this output", project_target_path(project, target), method: :delete,
            form: { data: { turbo_frame: "_top" } },
            class: "mt-4 cursor-pointer text-sm text-red-700 hover:underline",
            data: { turbo_confirm: "Remove “#{target.name}” and its #{pluralize(target.builds.size, 'build')}?" } %>
    </div>
  </div>
</div>
