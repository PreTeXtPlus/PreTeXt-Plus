<% content_for :title, "New account" %>
<% content_for :heading, "Create account" %>

<%= form_with model: @user do |form| %>
  <%= render "fields_for", form: form %>
  <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
    <%= form.submit "Register and sign in", class: "#{button_classes(color: "green")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
    <%= link_to "Sign into existing account", new_user_session_path, class: "text-sm text-blue-700 underline hover:no-underline" %>
  </div>
<% end %>

<div class="my-4 text-sm text-gray-700">
  By creating an account, you agree to our updated
  <%= link_to "Terms of Service", tos_path, class: "text-gray-900 hover:text-black hover:underline" %>
  and
  <%= link_to "Privacy Policy", privacy_path, class: "text-gray-900 hover:text-black hover:underline" %>.
</div>
