<% content_for(:title, 'Account') %>
<% content_for(:heading, "Account Profile (#{@user.email})") %>

<%= form_with model: @user, class: "my-4" do |form| %>
  <%= render "users/fields_for", form: form %>

  <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
    <div class="inline">
      <%= form.submit "Update account", class: "#{button_classes(color: "blue")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
    </div>
  </div>
<% end %>

<h2 class="text-2xl font-semibold mb-2 mt-20">Subscription Status</h2>

<%= render "subscriptions/status", user: @user %>
