<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333;">
  <h2>Shared Import Conversion</h2>

  <p>
    An author converted <strong><%= @file_name %></strong> with <%= @engine.presence || "an experimental converter" %>
    and chose to share it.
  </p>

  <% if @error.present? %>
    <h3>The conversion failed</h3>
    <p style="background-color: #f5f5f5; padding: 12px; border-left: 4px solid #cc3300; white-space: pre-wrap;"><%= @error %></p>
  <% end %>

  <h3>Details</h3>
  <dl style="margin: 16px 0;">
    <% if @context.present? %>
      <dt style="font-weight: bold; margin-top: 8px;">Shared from:</dt>
      <dd style="margin: 0 0 12px 0;"><%= @context %></dd>
    <% end %>

    <dt style="font-weight: bold; margin-top: 8px;">Original file:</dt>
    <dd style="margin: 0 0 12px 0;">
      <%= @file_name %> (<%= number_to_human_size(@file_size) %>)
      — <%= @file_attached ? "attached" : "too large to attach" %>
    </dd>

    <dt style="font-weight: bold; margin-top: 8px;">Converted PreTeXt:</dt>
    <dd style="margin: 0 0 12px 0;">
      <% if @pretext_attached %>
        attached as <%= @pretext_name %> (<%= number_to_human_size(@pretext_size) %>)
      <% elsif @pretext_size > 0 %>
        too large to attach (<%= number_to_human_size(@pretext_size) %>)
      <% else %>
        none
      <% end %>
    </dd>

    <% if @project_url.present? %>
      <dt style="font-weight: bold; margin-top: 8px;">Project URL:</dt>
      <dd style="margin: 0 0 12px 0;"><a href="<%= @project_url %>"><%= @project_url %></a></dd>
    <% end %>

    <% if @user.present? %>
      <dt style="font-weight: bold; margin-top: 8px;">User:</dt>
      <dd style="margin: 0 0 12px 0;"><%= @user.email %> (ID: <%= @user.id %>)</dd>
    <% end %>
  </dl>
</div>
