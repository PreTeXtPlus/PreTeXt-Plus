<h1 style="font-size: 22px; font-weight: bold; margin: 0 0 16px;">
  <%= @kind == :new ? "New Subscription" : "Subscription Renewal" %>
</h1>
<p style="margin: 0 0 16px; color: #51545E;">
  A payment of <strong><%= @amount %></strong> was received<%= @manual ? ", recorded manually (not processed through Stripe)" : "" %>.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin-bottom: 24px;">
  <tbody>
    <tr style="border-bottom: 1px solid #E2E2E2;">
      <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">User</td>
      <td style="padding: 8px 12px; font-size: 14px;">
        <% if @user %>
          <%= @user.name %> &lt;<%= @user.email %>&gt;
        <% else %>
          <span style="color: #6B6E76;">—</span>
        <% end %>
      </td>
    </tr>
    <tr style="border-bottom: 1px solid #E2E2E2;">
      <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Plan</td>
      <td style="padding: 8px 12px; font-size: 14px;"><%= @plan_name || @subscription.processor_plan %></td>
    </tr>
    <tr style="border-bottom: 1px solid #E2E2E2;">
      <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Billing</td>
      <td style="padding: 8px 12px; font-size: 14px;">
        <% if @interval == "year" %>
          Annual
        <% elsif @interval == "month" %>
          Monthly
        <% else %>
          <span style="color: #6B6E76;">—</span>
        <% end %>
      </td>
    </tr>
    <tr style="border-bottom: 1px solid #E2E2E2;">
      <td style="padding: 8px 12px; font-size: 13px; color: #6B6E76; white-space: nowrap;">Amount</td>
      <td style="padding: 8px 12px; font-size: 14px;"><%= @amount %></td>
    </tr>
  </tbody>
</table>
