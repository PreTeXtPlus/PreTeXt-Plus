<h1 style="margin-top: 0; color: #333333; font-size: 22px; font-weight: bold; text-align: left;">You're now the owner of a project</h1>

<div style="color: #51545E; font-size: 16px; line-height: 1.625;">
  <p>
    <%= @previous_owner.name_with_email %> made you the owner of
    <strong><%= @project.title %></strong> on PreTeXt.Plus.
    <%= @previous_owner.name_with_email %> remains a
    collaborator on the project.
  </p>
  <p style="text-align: center; margin: 32px 0;">
    <a href="<%= project_url(@project) %>" style="background-color: #16a34a; color: #ffffff; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;">Open the project</a>
  </p>
</div>

<table style="width: 100%; margin-top: 32px; padding-top: 24px; border-top: 1px solid #EAEAEC;">
  <tr>
    <td style="font-size: 13px; color: #6B6E76; text-align: center;">
      You are receiving this because you have an account on
      <a href="https://pretext.plus" style="color: #3869D4;">PreTeXt.Plus</a>.
    </td>
  </tr>
</table>
