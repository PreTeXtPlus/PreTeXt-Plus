<h1 style="margin-top: 0; color: #333333; font-size: 22px; font-weight: bold; text-align: left;">You're invited to collaborate</h1>

<div style="color: #51545E; font-size: 16px; line-height: 1.625;">
  <p>
    <%= @owner.name_with_email %> invited you to collaborate on their project
    <strong><%= @project.title %></strong> on PreTeXt.Plus, a free online
    editor for creating accessible scholarly documents.
  </p>
  <p>
    Create an account using this email address (<%= @collaboration.invited_email %>)
    and the project will appear in your project list as soon as you confirm your email.
  </p>
  <p style="text-align: center; margin: 32px 0;">
    <a href="<%= new_user_url %>" style="background-color: #16a34a; color: #ffffff; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;">Create your account</a>
  </p>
</div>

<table style="width: 100%; margin-top: 32px; padding-top: 24px; border-top: 1px solid #EAEAEC;">
  <tr>
    <td style="font-size: 13px; color: #6B6E76; text-align: center;">
      This invitation was sent by a
      <a href="https://pretext.plus" style="color: #3869D4;">PreTeXt.Plus</a>
      user. If you weren't expecting it, you can safely ignore this email.
    </td>
  </tr>
</table>
