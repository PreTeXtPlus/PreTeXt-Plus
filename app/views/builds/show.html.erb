<%# A single build's log, as a deep-linkable page. Build history lives in the target
    drawer; this exists so "Log" in that table, and links in support email, resolve to
    something permanent. %>
<% content_for :title, "Build log — #{@project.title}" %>
<% content_for :breadcrumb do %>
  <%= link_to "Projects", projects_path, class: "hover:underline" %> /
  <%= link_to @project.title, @project, class: "hover:underline" %> /
  <%= link_to @build.target.name, project_target_path(@project, @build.target), class: "hover:underline" %> /
<% end %>
<% content_for :heading, "Build log" %>
<% content_for :subtitle do %>
  Started <%= local_time_tag(@build.created_at, relative: true) %>
<% end %>
<% content_for :actions do %>
  <%= build_history_pill(@build, @build.target) %>
<% end %>

<% if @build.unresolved? %>
  <div class="mt-4 flex flex-wrap items-center gap-3 rounded-lg border border-sky-200 bg-sky-50 p-3 text-sm text-sky-900">
    <span><%= @build.queued? ? "This build is queued, waiting for a free slot." : "This build is still running." %></span>
    <%# Nothing to check on the server for a build that was never sent there. %>
    <% unless @build.queued? %>
      <%= button_to "Check server", check_status_project_build_path(@project, @build),
            class: "#{button_classes(color: "sky", outlined: true)} px-2 py-1 text-xs" %>
    <% end %>
    <%= button_to "Cancel", cancel_project_build_path(@project, @build),
          class: "#{button_classes(color: "sky", outlined: true)} px-2 py-1 text-xs",
          data: { turbo_confirm: "Stop this build? Nothing that is already published changes." } %>
  </div>
<% end %>

<% if @build.success_awaiting_review? %>
  <%# The log is where an author decides, so it says what the decision is and where it is
      made. The button itself stays in the drawer, next to the link that previews this
      output -- reading the log is half of reviewing it, looking at the result is the
      other half. %>
  <div class="mt-4 rounded-lg border border-orange-200 bg-orange-50 p-3 text-sm text-orange-900">
    This build reported errors but still produced output, which has been imported.
    <strong>It is not live:</strong> readers keep seeing the previous build until you
    choose to use this one, in
    <%= link_to "this output's details", project_target_path(@project, @build.target),
          class: "underline", data: { turbo: false } %>.
    The log below is where to find out what went wrong.
  </div>
<% elsif @build.built_with_errors? %>
  <div class="mt-4 rounded-lg border border-orange-200 bg-orange-50 p-3 text-sm text-orange-900">
    This build reported errors, but it still produced output and you chose to use it —
    it is what readers see. The log below is where to find out what went wrong, and
    whether the missing parts matter.
  </div>
<% end %>

<% if @build.log.present? %>
  <pre class="mt-4 overflow-auto rounded-lg bg-gray-900 p-4 text-xs text-gray-100 whitespace-pre-wrap"><%= @build.log %></pre>
<% else %>
  <p class="mt-4 text-gray-600">No log was returned for this build.</p>
<% end %>

<div class="mt-6 flex flex-wrap items-center gap-3 border-t border-gray-200 pt-5">
  <% if @build.success? && @build.entry_path.present? %>
    <%= link_to "View output", build_file_path(@build, @build.entry_path),
          class: "#{button_classes(color: "gray", outlined: true)} px-3 py-2 text-sm",
          target: "_blank", rel: "noopener", data: { turbo: false } %>
  <% end %>
  <% if @build.zip.attached? %>
    <%= link_to "Download zip", build_zip_path(@build),
          class: "#{button_classes(color: "gray", outlined: true)} px-3 py-2 text-sm",
          data: { turbo: false } %>
  <% end %>
  <%= button_to "Delete this build", project_build_path(@project, @build), method: :delete,
        class: "cursor-pointer text-sm text-red-700 hover:underline",
        data: { turbo_confirm: "Delete this build?" } %>
</div>
