<div class="flex size-full flex-1"
    data-controller="editor"
    data-editor-project-id-value="<%= project.id %>"
    data-editor-editor-state-url-value="<%= project_path(project, format: :json) %>"
    data-editor-pandoc-url-value="<%= pandoc_projects_path %>"
    data-editor-root-path-value="<%= root_path %>"
    data-editor-user-email-value="<%= current_user.email %>"
    data-editor-has-profile-page-value="<%= current_user.has_profile_page? %>"
    data-editor-profile-path-value="<%= current_user.has_profile_page? ? user_profile_path(current_user.username) : "" %>"
    data-editor-settings-path-value="<%= edit_user_path(current_user) %>"
    data-editor-subscriptions-path-value="<%= subscriptions_path %>"
    data-editor-sign-out-path-value="<%= destroy_user_session_path %>"
    data-turbo="false">
  <div data-editor-target="root" class="w-full flex-1 min-h-0">
    <div class="flex h-full items-center justify-center">
      <div class="mx-5 text-center">
        <p>
          Loading editor…
        </p>
        <p>
          PreTeXt.Plus works best in an updated Chromium-based browser such as Google Chrome or Microsoft Edge.
          If you're stuck on message, please update your browser or switch to Chrome/Edge.
        </p>
      </div>
    </div>
  </div>
</div>
