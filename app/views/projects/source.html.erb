<% content_for :title, "Source for #{@project.title}" %>
<% content_for :full_screen_content do %>
<div class="flex size-full flex-1 flex-col min-h-0">
  <div class="shrink-0 p-3 w-full text-center text-sm text-gray-500">
    <% if @project.user == current_user %>
      You are the owner of this project
      (<%= link_to "Manage", @project, class: "text-blue-500 hover:font-semibold" %>).
      <% unless @project.private_visibility? %>
        Copy this link to share your project's source code with others:
        <input type="text" class="mt-2 block mx-auto max-w-full field-sizing-content p-1 text-sm text-gray-700 border border-gray-400 rounded" value="<%= share_source_project_url(@project) %>" readonly onclick="this.select()" onfocus="this.select()">
      <% else %>
        This project is private. You can share the source code with others by
        <%= link_to "making it public", @project, class: "text-blue-500 hover:font-semibold" %>.
      <% end %>
    <% else %>
      This is a read-only view of the source code for <%= @project.title %>.
      You can <%= button_to "copy this project", copy_project_path(@project), class: "text-purple-700 hover:font-semibold cursor-pointer", form_class: "inline" %>
      to your own account to edit it.
    <% end %>
  </div>
  <div class="flex size-full flex-1 min-h-0"
      data-controller="shared-source"
      data-shared-source-project-id-value="<%= @project.id %>"
      data-shared-source-source-url-value="<%= share_source_project_path(@project, format: :json) %>"
      data-shared-source-copy-url-value="<%= copy_project_path(@project) %>"
      data-turbo="false">
    <div data-shared-source-target="root" class="w-full flex-1 min-h-0">
      <div class="flex h-full items-center justify-center">
        <div class="mx-5 text-center">
          <p>
            Loading…
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>
