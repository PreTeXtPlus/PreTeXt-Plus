<% content_for :title, "My projects" %>
<% content_for :heading, "My projects" %>
<% content_for :actions do %>
  <%= link_to "Back to dashboard", projects_path, class: "#{button_classes(color: "gray")} px-3.5 py-2" %>
<% end %>

<div class="min-w-full space-y-5">
  <% if @projects.any? %>
    <%= render partial: "card", collection: @projects, as: :project %>
  <% else %>
    <p class="text-center my-10">No projects found.</p>
  <% end %>

  <%= paginate @projects %>
</div>
