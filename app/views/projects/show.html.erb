<% content_for :title, @project.title %>
<% content_for :breadcrumb do %>
  <%= link_to "Projects", projects_path, class: "hover:underline" %> /
<% end %>
<% content_for :heading do %>
  <%= @project.title %>
  <%= project_visibility_pill(@project) %>
  <%= project_shared_pill if @project.access(current_user) == :shared %>
<% end %>
<% content_for :subtitle do %>
  <p>
    Last edited <%= time_ago_in_words(@project.source_updated_at) %> ago
  </p>
  <% if can? :update_visibility, @project %>
    <%= form_with model: @project, method: :patch,
          class: "mt-2 flex items-center gap-2",
          data: { controller: "project-visibility",
                  project_visibility_published_count_value: @project.targets.where(published: true).count,
                  action: "submit->project-visibility#confirm" } do |form| %>
      <%= form.label :visibility, "Visibility on your public profile", class: "text-xs text-gray-600" %>
      <%= form.select :visibility, Project.visibilities.keys.map { |v| [ v.humanize, v ] },
            {}, { class: "rounded-md bg-white border border-gray-300 px-2 py-1 text-xs",
                  data: { project_visibility_target: "select" } } %>
      <%= form.submit "Update",
            class: "#{button_classes(color: "gray", outlined: true)} px-2 py-1 text-xs" %>
    <% end %>
  <% end %>
<% end %>

<div class="mt-4">
  <% if @project.description.present? %>
    <p class="text-sm text-gray-700 whitespace-pre-line"><%= @project.description %></p>
  <% elsif !can?(:update, @project) %>
    <p class="text-sm text-gray-500 italic">No description yet.</p>
  <% end %>

  <% if can? :update, @project %>
    <details class="mt-2">
      <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-gray-500">
        Edit description
      </summary>
      <%= form_with model: @project, method: :patch, class: "mt-2 flex flex-col gap-2" do |form| %>
        <%= form.text_area :description, rows: 3, placeholder: "What's this project about?",
              class: "rounded-md border border-gray-300 px-3 py-2 text-sm" %>
        <%= form.submit "Save description", class: "#{button_classes(color: "gray", outlined: true)} self-start px-3 py-1.5 text-sm" %>
      <% end %>
    </details>
  <% end %>
</div>

<% content_for :actions do %>
  <%= link_to "Write", edit_project_path(@project),
        class: "#{button_classes(color: "indigo")} px-3.5 py-2" %>
  <%= button_to "Make copy", copy_project_path(@project),
        class: "#{button_classes(color: "purple")} px-3.5 py-2" %>
  <%# Source, assets and a project.ptx -- opens directly in PreTeXt-CLI. %>
  <%= link_to "Download source", download_project_path(@project),
        class: "#{button_classes(color: "gray", outlined: true)} px-3.5 py-2",
        data: { turbo: false } %>
  <% unless @project.private_visibility? %>
    <%= link_to "Share source", share_source_project_path(@project),
          class: "#{button_classes(color: "gray", outlined: true)} px-3.5 py-2",
          data: { turbo: false } %>
  <% end %>
  <% if current_user&.admin? %>
    <%= link_to "🔒 View as admin", admin_project_path(@project),
          class: "#{button_classes(color: "orange", outlined: true)} px-3.5 py-2" %>
  <% end %>
<% end %>

<%# Subscribes the dashboard to this project's target rows. Build#mark! broadcasts here
      on every status transition, which is what replaced the old <meta refresh>.
      stream-reconnect morphs the page back in from the server whenever this
      subscription reconnects, to pick up anything broadcast while it was down --
      see app/javascript/controllers/stream_reconnect_controller.js. %>
  <%= turbo_stream_from [ @project, :targets ], data: { controller: "stream-reconnect" } %>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-mono text-xs font-semibold uppercase tracking-widest text-gray-500">
      Outputs
      (<%= @targets.size %>/<%= @project.user.target_quota %>)
    </h2>
    <div class="flex items-center gap-2">
      <%# Only ever appears when something needs it -- everything :never or :stale --
          so it reads as urgent (filled, indigo) the same way an individual row's
          Build/Rebuild button does once it starts emphasizing itself. %>
      <% if (bulk_label = bulk_build_label(@targets)).present? %>
        <% if can?(:build_all, @project) %>
          <%= button_to bulk_label, build_all_project_builds_path(@project),
                class: "#{button_classes(color: "indigo")} px-3 py-1.5 text-sm" %>
        <% elsif @project.user == current_user %>
          <p class="text-sm text-gray-500">
            <%= link_to "Subscribe", subscriptions_path, class: "text-blue-600 hover:underline" %>
            to enable one-click bulk builds!
          </p>
        <% end %>
      <% end %>
      <%# Beside the outputs rather than up with Write and Download, because that is what
          these settings change: how every output of this project gets built. Each output
          can still overrule them from its own drawer. %>
      <%= link_to "Build settings", edit_project_publication_settings_path(@project),
            data: { turbo_frame: "modal" },
            class: "#{button_classes(color: "gray", outlined: true)} px-3 py-1.5 text-sm" %>
    </div>
  </div>

  <div id="targets" class="mt-3 flex flex-col gap-2">
    <%= render @targets %>
  </div>

  <% if @targets.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-600">
      This project has no outputs yet.
    </p>
  <% end %>

  <%# Target.new, not @project.targets.new -- the latter appends to the loaded
      association and would inflate the count rendered below. %>
  <% if can?(:create, Target.new(project: @project)) %>
    <details class="mt-3 rounded-lg border border-dashed border-gray-300 p-4">
      <summary class="cursor-pointer text-sm text-gray-600">+ Add an output</summary>
      <%= form_with model: [ @project, Target.new ], class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
        <div>
          <%= form.label :kind, "Output format", class: "block text-xs text-gray-600" %>
          <%= form.select :kind, target_kind_options(@project), {},
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        </div>
        <div>
          <%= form.label :name, "Name (optional)", class: "block text-xs text-gray-600" %>
          <%= form.text_field :name, placeholder: "Print PDF", required: false,
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        </div>
        <%= form.submit "Add output",
              class: "#{button_classes(color: "indigo")} px-3 py-2 text-sm" %>
      <% end %>
      <p class="mt-3 text-xs text-gray-500">
        Name is a frieldy name for the output, like "Print PDF" or  "Instructor edition".  Several outputs may be of the same output format — a student and an instructor website, say.
      </p>
    </details>
  <% elsif @project.user == current_user %>
    <%# The limit is the OWNER's, since that is whose plan the quota follows (see
        Ability). A collaborator can't lift it by subscribing themselves, so -- like
        the build_all upsell above -- they see nothing here rather than being sold to
        or sent to ask the owner. %>
    <p class="mt-3 text-sm text-gray-500">
      You've reached the maximum of <%= @project.user.target_quota %> outputs for this project.
      <% unless current_user.subscribed? %>
        <%= link_to "Subscribe", subscriptions_path, class: "text-blue-600 hover:underline" %> to increase this limit.
      <% end %>
    </p>
  <% end %>

  <%= render "collaborations/panel", project: @project %>

  <%= render "projects/assets", project: @project %>

  <%# html_source is no longer written for any project (see Project#enqueue_html_source_job,
      removed); this only ever renders for projects that got one before the cutover. %>
  <% if @project.html_source.present? %>
    <p class="mt-8 text-xs text-gray-500">
      This project has a legacy <%= link_to "quick-preview link", share_project_path(@project),
            class: "text-blue-600 hover:underline", target: "_blank", rel: "noopener" %>.
      This link will stop working after November 1, 2026 — build and publish a website for future
      access.
    </p>
  <% end %>

  <div class="mt-8 flex items-center justify-between border-t border-gray-200 pt-5">
    <p class="text-sm text-gray-500">First created <%= local_time_tag(@project.created_at, relative: true) %></p>
    <%# Deleting a project stays with its owner: a collaborator holds edit access,
        not the right to destroy someone else's work. %>
    <% if can? :destroy, @project %>
      <%= button_to "Delete this project", @project, method: :delete,
            class: "cursor-pointer rounded-md px-3 py-2 text-sm text-red-700 hover:bg-red-50",
            data: { turbo_confirm: "Delete “#{@project.title}” and all of its outputs? This cannot be undone." } %>
    <% end %>
  </div>

<%# The drawer loads into here from the ⋯ on any target row, and is rendered inline when
    this page *is* a target URL -- TargetsController#show renders the dashboard for any
    request that is not the frame asking. That is what gives the overlay something behind
    it: closing it then reveals the project, rather than emptying the whole document.

    refresh: "morph" is what makes a build's reload_drawer broadcast morph this frame
    rather than replace it, so a refresh mid-read leaves the panel's elements in place --
    including the build log's own scroll box, which keeps its position.

    On the inline render the src has to be set here, because no frame navigation set it:
    Turbo will not reload a frame that has no src, and that is the case an author lands in
    by following a build-log breadcrumb or a bookmark. It costs one immediate re-fetch of
    the panel the server just rendered -- Turbo clears `complete` when it upgrades an
    element that has a src, so there is no way to hand it pre-filled content and a src at
    the same time -- which is a fair price on an uncommon path for a drawer that then
    refreshes like any other. %>
<%= turbo_frame_tag "drawer", refresh: "morph",
      src: (project_target_path(@project, @target) if @target) do %>
  <%= render "targets/drawer", project: @project, target: @target if @target %>
<% end %>
