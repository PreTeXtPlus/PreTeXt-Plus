<% content_for :title, @project.title %>

<div class="mx-auto w-full p-4 md:w-4/5 lg:w-3/4">
  <%# Subscribes the dashboard to this project's target rows. Build#mark! broadcasts here
      on every status transition, which is what replaced the old <meta refresh>. %>
  <%= turbo_stream_from [ @project, :targets ] %>

  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-gray-200 pb-5">
    <div class="min-w-0">
      <p class="font-mono text-xs text-gray-500">
        <%= link_to "Projects", projects_path, class: "hover:underline" %> /
      </p>
      <h1 class="mt-1 text-2xl font-semibold"><%= @project.title %></h1>
      <p class="mt-1 text-sm text-gray-600">
        Edited <%= time_ago_in_words(@project.source_updated_at) %> ago ·
        <%= pluralize(@project.divisions.size, "division") %> ·
        <%= pluralize(@project.assets.size, "asset") %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_project_path(@project),
            class: "rounded-md bg-indigo-600 px-3.5 py-2 font-medium text-white hover:bg-indigo-500" %>
      <% if can? :source, @project %>
        <%= link_to "Share source", share_source_project_path(@project),
              class: "rounded-md border border-gray-300 px-3.5 py-2 font-medium hover:bg-gray-50" %>
      <% end %>
      <%# Source, assets and a project.ptx -- opens directly in PreTeXt-CLI. %>
      <%= link_to "Download project", download_project_path(@project),
            class: "rounded-md border border-gray-300 px-3.5 py-2 font-medium hover:bg-gray-50",
            data: { turbo: false } %>
      <%# Quick build stays reachable until every project has a real html build to point
          at. Retired in PR 5. %>
      <%= link_to "Quick preview", share_project_path(@project),
            class: "rounded-md border border-gray-300 px-3.5 py-2 font-medium hover:bg-gray-50",
            target: "_blank", rel: "noopener" %>
    </div>
  </div>

  <h2 class="mt-8 font-mono text-xs font-semibold uppercase tracking-widest text-gray-500">Outputs</h2>

  <div id="targets" class="mt-3 flex flex-col gap-2">
    <%= render @project.targets %>
  </div>

  <% if @project.targets.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-600">
      This project has no outputs yet.
    </p>
  <% end %>

  <%# Target.new, not @project.targets.new -- the latter appends to the loaded
      association and would inflate the count rendered below. %>
  <% if can?(:create, Target.new(project: @project)) %>
    <details class="mt-3 rounded-lg border border-dashed border-gray-300 p-4">
      <summary class="cursor-pointer text-sm text-gray-600">+ Add an output</summary>
      <%= form_with model: [ @project, Target.new ], class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
        <div>
          <%= form.label :label, "Name", class: "block text-xs text-gray-600" %>
          <%= form.text_field :label, placeholder: "Print PDF",
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        </div>
        <div>
          <%= form.label :name, "Target name", class: "block text-xs text-gray-600" %>
          <%= form.text_field :name, placeholder: "print", required: true,
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 font-mono text-sm" %>
        </div>
        <div>
          <%= form.label :kind, "Output", class: "block text-xs text-gray-600" %>
          <%= form.select :kind, target_kind_options(@project), {},
                class: "mt-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        </div>
        <%= form.submit "Add output",
              class: "cursor-pointer rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
      <p class="mt-3 text-xs text-gray-500">
        The target name is what identifies this output in <code>project.ptx</code>, so it also
        works with <code>pretext build &lt;name&gt;</code> on a downloaded copy. Several outputs
        may be of the same kind — a student and an instructor website, say.
      </p>
    </details>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">
      You've reached the limit of <%= current_user.target_quota %> outputs for this project.
    </p>
  <% end %>

  <div class="mt-8 flex items-center justify-between border-t border-gray-200 pt-5">
    <%# The quota is not worth reporting until it bites; the "+ Add an output" block
        already says so when it does. %>
    <p class="text-sm text-gray-500">
      <%= pluralize(@project.targets.size, "output") %>
    </p>
    <%= button_to "Delete this project", @project, method: :delete,
          class: "cursor-pointer rounded-md px-3 py-2 text-sm text-red-700 hover:bg-red-50",
          data: { turbo_confirm: "Delete “#{@project.title}” and all of its outputs? This cannot be undone." } %>
  </div>
</div>

<%# The drawer loads into here from the ⋯ on any target row. %>
<%= turbo_frame_tag "drawer" %>
