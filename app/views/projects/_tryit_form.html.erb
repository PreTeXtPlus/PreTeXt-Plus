<div class="flex size-full flex-1"
     data-controller="tryit"
     data-tryit-project-value="<%= project.tryit_json %>"
     data-tryit-root-path-value="<%= root_path %>"
     data-tryit-new-user-path-value="<%= new_user_path %>"
     data-tryit-new-session-path-value="<%= new_user_session_path %>">
  <div data-tryit-target="root" class="w-full flex-1 min-h-0">
    <div class="flex h-full items-center justify-center">
      <div class="mx-5 text-center">
        <p>
          Loading editor…
        </p>
        <p>
          PreTeXt.Plus works best in an updated Chromium-based browser such as Google Chrome or Microsoft Edge.
          If you're stuck on message, please update your browser or switch to Chrome/Edge.
        </p>
      </div>
    </div>
  </div>
</div>
