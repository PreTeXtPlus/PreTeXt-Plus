<%# One project row on the projects index. Pass shared: true for the "Shared
    with me" list, which names the owner instead of offering owner-only
    affordances. %>
<% shared = local_assigns.fetch(:shared, false) %>
<div class="m-3 rounded-xl bg-white p-4 ring-2 ring-gray-100 hover:ring-indigo-200">
  <% if project.is_template? %>
    <div class="mt-1 text-sm text-amber-800 bg-amber-50 rounded-md sm:p-2">
      ⚠ This project is offered as a template for new projects. Edit with care —
      your changes affect what new users start from.
    </div>
  <% end %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:p-6">
  <span class="hidden sm:grid sm:size-14 sm:shrink-0 sm:place-content-center" aria-hidden="true">
    <% if project.root_division&.latex_source_format? %>
      <%= image_tag "latex-pretext-logo.svg", alt: "" %>
    <% elsif project.root_division&.markdown_source_format? %>
      <%= image_tag "markdown-pretext-logo.svg", alt: "" %>
    <% else %>
      <%= image_tag "pretext-logo.svg", alt: "" %>
    <% end %>
  </span>

  <div class="min-w-0 flex-1">
    <h3 class="text-lg font-medium">
      <%= link_to project.title, project, class: "hover:underline", data: { turbo: false } %>
    </h3>

    <%# The whole status report for this project at a glance: one chip per output,
        so scanning the column answers "what needs rebuilding?" across every project. %>
    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      <% project.targets.each do |target| %>
        <% state = target.state %>
        <% label, classes = TargetsHelper::STATE_PILL.fetch(state) %>
        <%= link_to project_target_path(project, target),
              class: "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-xs font-semibold #{classes}",
              title: "#{target.name} — #{label.downcase}", data: { turbo: false } do %>
          <span class="size-1.5 rounded-full bg-current <%= 'animate-pulse' if state == :building %>"></span>
          <%= target.name %>
        <% end %>
      <% end %>
    </div>

    <p class="mt-2 text-sm text-gray-700">
      <% if shared %>
        Shared by <%= project.user.name_with_email %> ·
      <% end %>
      Edited
      <%= local_time_tag(project.source_updated_at, relative: true) %>
    </p>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <%= link_to "Manage", project, class: "rounded-md border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50", data: { turbo: false } %>
    <%= link_to "Write", edit_project_path(project), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500", data: { turbo: false } %>
  </div>
  </div>
</div>
