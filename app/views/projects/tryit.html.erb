<% content_for :title, "Try it!" %>

<% content_for :full_screen_content do %>
<div class="flex size-full flex-1 flex-col min-h-0">

<div class="shrink-0 bg-sky-50/70 ">
  <div class="mx-auto max-w-6xl py-2 px-3">
    <div class="flex flex-row items-center justify-between gap-2">
      <div>
        <h1 class="text-xl font-semibold text-sky-900 whitespace-nowrap">
          <span class="sm:hidden">Try PreTeXt!</span>
          <span class="hidden sm:inline">Try PreTeXt in your web browser!</span>
        </h1>
      </div>
      <div class="flex flex-nowrap gap-2">
        <%= link_to "Create account", new_user_path, class: "#{button_classes(color: "sky")} px-2 py-1 text-sm" %>
        <%= link_to "Sign in", new_user_session_path, class: "#{button_classes(color: "sky", outlined: true)} px-2 py-1 text-sm" %>
      </div>
    </div>
  </div>
</div>

<%= render "tryit_form", project: @project %>

</div>
<% end %>
