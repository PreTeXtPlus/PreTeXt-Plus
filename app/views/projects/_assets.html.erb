<%# Read-only asset gallery for the project dashboard -- editing/uploading
    assets stays in the editor's own asset manager (see AssetManagerModal in
    the web-editor package); this is just a quick-glance inventory. %>
<% assets = project.assets.order(:ref).includes(file_attachment: :blob) %>

<h2 class="mt-8 font-mono text-xs font-semibold uppercase tracking-widest text-gray-500">
  Assets
  (<%= assets.size %>)
</h2>

<% if assets.any? %>
  <ul class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
    <% assets.each do |asset| %>
      <li class="flex flex-col items-center gap-1 overflow-hidden rounded-lg border border-gray-200 p-2 text-center">
        <%= link_to asset.url, class: "hover:ring hover:ring-slate-500 hover:rounded-sm", target: "_blank" do %>
          <% if asset.thumbnailable? %>
            <%= image_tag share_asset_thumbnail_project_path(project, ref: asset.ref, format: asset.file_extension),
                  alt: asset.title.presence || asset.ref,
                  loading: "lazy",
                  class: "h-16 w-16 rounded object-cover bg-gray-50" %>
          <% else %>
            <div class="flex h-16 w-16 items-center justify-center rounded bg-gray-50 text-2xl" aria-hidden="true">📄</div>
          <% end %>
        <% end %>
        <%= tag.span class: "w-full truncate text-xs text-gray-700" do %>
          <%= asset.title %><br><span class="font-mono"><%= asset.ref %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-3 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-600">
    This project has no assets yet. Add images from the editor's asset manager.
  </p>
<% end %>
