<%# Automatic backups on the project dashboard; see ProjectBackup for how they are
    taken and rotated. A subscriber feature on the OWNER's plan, like the output
    quota above: a lapsed owner keeps what was already taken (restorable, aging
    out) but gets no new ones. Collaborators see the same list and may restore
    from it -- a restore only ever makes a new project, owned by whoever asks --
    but never the upsell, since subscribing themselves would not change this. %>
<% backups = project.backups.to_a %>
<% owner_subscribed = project.user.has_subscriber_benefits? %>
<% is_owner = project.user == current_user %>

<% if backups.any? || owner_subscribed || is_owner %>
  <h2 class="mt-8 font-mono text-xs font-semibold uppercase tracking-widest text-gray-500">
    Automatic backups
  </h2>

  <% if backups.any? %>
    <ul class="mt-3 divide-y divide-gray-200 rounded-lg border border-gray-200">
      <% backups.each do |backup| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <span class="text-sm text-gray-700">
            Saved <%= local_time_tag(backup.backed_up_at, relative: true) %>
          </span>
          <% if can? :restore_backup, project %>
            <%= button_to "Restore as new project",
                  restore_backup_project_path(project, backup_id: backup.id),
                  class: "#{button_classes(color: "indigo", outlined: true)} px-3 py-1.5 text-sm",
                  data: { turbo_confirm: "Create a new project from this backup? This project is left as it is." } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p class="mt-3 text-sm text-gray-500">
    <% if owner_subscribed %>
      <% if backups.empty? %>
        No backups yet.
      <% end %>
      A backup is saved within 10 minutes of an edit, and older ones are kept from about an
      hour, three hours, and a day earlier. Restoring one makes a new project and leaves this
      one unchanged.
    <% elsif is_owner %>
      <% if backups.any? %>
        New backups are paused while this account has no subscription.
      <% else %>
        Subscribers' projects are backed up automatically, with versions kept from the last
        10 minutes, hour, three hours, and day.
      <% end %>
      <%= link_to "Subscribe", subscriptions_path, class: "text-blue-600 hover:underline" %>
      to <%= backups.any? ? "resume them" : "turn them on" %>.
    <% end %>
  </p>
<% end %>
