<%# Which of the owner's collections hold this project. Rendered for the owner only. %>
<% collections = current_user.collections.order(:name).to_a %>
<% filed = project.collection_memberships.pluck(:collection_id) %>

<h2 class="mt-8 font-mono text-xs font-semibold uppercase tracking-widest text-gray-500">
  Collections
</h2>

<% if collections.any? %>
  <%= form_with url: project_collections_path(project), method: :patch, class: "mt-3" do |form| %>
    <%# Unchecking every box must still send the parameter, or nothing would be removed. %>
    <%= hidden_field_tag "collection_ids[]", "", id: nil %>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <% collections.each do |collection| %>
        <label class="flex items-center gap-2 text-sm text-gray-800">
          <%= check_box_tag "collection_ids[]", collection.id, filed.include?(collection.id),
                id: "collection_#{collection.id}", class: "h-4 w-4 rounded border-gray-300 text-blue-600" %>
          <%= collection.name %>
        </label>
      <% end %>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <%= form.submit "Save collections", class: "#{button_classes(color: "gray", outlined: true)} px-3 py-1.5 text-sm" %>
      <%= link_to "+ New collection", new_collection_path(project_id: project.id), class: "text-sm text-blue-600 hover:underline" %>
    </div>
  <% end %>
<% else %>
  <p class="mt-3 text-sm text-gray-500">
    <%= link_to "Create a collection", new_collection_path(project_id: project.id), class: "text-blue-600 hover:underline" %>
    to group this project with related ones.
  </p>
<% end %>
