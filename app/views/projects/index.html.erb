<% content_for :title, "Projects" %>

<div class="w-full mx-auto p-2 md:w-2/3">
  <div class="flex items-center gap-2">
    <h1 class="text-3xl">
      Projects
      (<%= @projects.count %>/<%= current_user.project_quota %>)
    </h1>
    <% if current_user && current_user.projects.count < current_user.project_quota %>
      <%= link_to "+ New project", new_project_path, class: "inline-flex select-none items-center gap-2 rounded-md cursor-pointer ml-1 px-4 py-2 my-1 text-medium bg-green-600 text-white font-bold drop-shadow-md hover:bg-green-500", data: { turbo: false } %>
    <% end %>
  </div>

  <div id="projects" class="min-w-full space-y-5">
    <% if current_user.present? and !current_user.confirmed? %>
      <div class="flex justify-center">
        <p class="my-2 py-2 px-3 bg-blue-50 border-blue-200 border-1 text-blue-500 rounded-md inline-block">
          ℹ Your email address has not yet been confirmed. Please
          <%= link_to "confirm your email", new_user_confirmation_path, class: "font-semibold hover:underline" %>
          within three days to maintain access.
        </p>
      </div>
    <% end %>
    <% unless current_user.subscribed? %>
      <div class="rounded-lg border-2 border-blue-500 p-4 text-sky-900 mt-6 mx-auto md:w-3/4">
        <p>
          Thanks for using <span class="font-semibold">PreTeXt.Plus</span>!
          We created this service so anyone can use the free and open-source PreTeXt project to create high-quality and accessible
          scholarly documents. If you'd like to support us, please consider becoming a sustaining subscriber, which helps us fund
          development and keep the service running for everyone. As a sustaining subscriber, you'll also get access to exclusive
          features and early access to new tools.
        </p>
        <div class="mt-4 flex gap-2 items-center">
          <span class="font-semibold">Support PreTeXt.Plus development:</span>
          <%= link_to subscriptions_path, class: "rounded-md px-3.5 py-2 bg-green-600 hover:bg-green-500 text-white font-medium" do %>
            Subscribe
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @projects.any? %>
      <% @projects.each do |project| %>
        <% edited_local = project.source_updated_at.localtime %>
        <div class="m-3 flex flex-col gap-4 rounded-xl bg-white p-4 ring-2 ring-gray-100 hover:ring-indigo-200 sm:flex-row sm:items-center sm:p-6">
          <span class="hidden sm:grid sm:size-14 sm:shrink-0 sm:place-content-center" aria-hidden="true">
            <% if project.root_division&.latex_source_format? %>
              <%= image_tag "latex-pretext-logo.svg", alt: "" %>
            <% elsif project.root_division&.markdown_source_format? %>
              <%= image_tag "markdown-pretext-logo.svg", alt: "" %>
            <% else %>
              <%= image_tag "pretext-logo.svg", alt: "" %>
            <% end %>
          </span>

          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-medium">
              <%= link_to project.title, project, class: "hover:underline", data: { turbo: false } %>
            </h3>

            <%# The whole status report for this project at a glance: one chip per output,
                so scanning the column answers "what needs rebuilding?" across every project. %>
            <div class="mt-2 flex flex-wrap items-center gap-1.5">
              <% project.targets.each do |target| %>
                <% state = target.state %>
                <% label, classes = TargetsHelper::STATE_PILL.fetch(state) %>
                <%= link_to project_target_path(project, target),
                      class: "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-xs font-semibold #{classes}",
                      title: "#{target.display_label} — #{label.downcase}", data: { turbo: false } do %>
                  <span class="size-1.5 rounded-full bg-current <%= 'animate-pulse' if state == :building %>"></span>
                  <%= target.display_label %>
                <% end %>
              <% end %>
            </div>

            <p class="mt-2 text-sm text-gray-700">
              Edited
              <%= tag.time("#{time_ago_in_words(project.source_updated_at)} ago",
                    datetime: project.source_updated_at.iso8601,
                    title: edited_local.strftime('%B %-d, %Y at %-I:%M %p %Z')) %>
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <%= link_to "Open", project, class: "rounded-md border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50", data: { turbo: false } %>
            <%= link_to "Edit", edit_project_path(project), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500", data: { turbo: false } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No projects found.</p>
    <% end %>
  </div>
</div>
