<% content_for :title, "New terms" %>
<% content_for :heading, "New terms" %>

<%= form_with model: @term, url: admin_terms_path do |form| %>
  <%= render "fields_for", form: form %>
  <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
    <%= form.submit "Create terms", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
