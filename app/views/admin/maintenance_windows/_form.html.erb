<%= form_with model: [:admin, maintenance_window], class: "space-y-6" do |form| %>
  <% if maintenance_window.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 text-sm">
      <ul class="list-disc pl-4 space-y-1">
        <% maintenance_window.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :starts_at, "Starts at", class: "block text-sm font-medium text-gray-700" %>
    <p class="mt-1 text-xs text-gray-500">In your time zone (<%= Time.zone.name %>); visitors see it in theirs.</p>
    <%= form.datetime_field :starts_at, class: "mt-2 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= form.label :note, class: "block text-sm font-medium text-gray-700" %>
    <p class="mt-1 text-xs text-gray-500">Optional. Shown in the banner after the start time, e.g. "Expect about 30 minutes of downtime."</p>
    <%= form.text_field :note, class: "mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div class="flex gap-2">
    <%= form.submit class: "#{button_classes(color: "blue")} px-3.5 py-2" %>
    <%= link_to "Cancel", admin_maintenance_windows_path, class: "#{button_classes(color: "gray")} px-3.5 py-2" %>
  </div>
<% end %>
