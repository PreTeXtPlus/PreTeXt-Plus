<% content_for :title, "Admin maintenance windows" %>
<% content_for :heading, "🔒 Maintenance windows" %>
<% content_for :subtitle, "Starting #{distance_of_time_in_words(MaintenanceWindow::WARNING_PERIOD)} before the next window, every page shows a dismissable warning banner." %>
<% content_for :actions do %>
  <%= link_to "Schedule maintenance", new_admin_maintenance_window_path, class: "#{button_classes(color: "blue")} px-3.5 py-2" %>
  <%= link_to "Back to dashboard", admin_root_path, class: "#{button_classes(color: "gray")} px-3.5 py-2" %>
<% end %>

<div class="mt-6 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-600">
        <th class="px-4 py-3 font-medium">Starts</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Note</th>
        <th class="px-4 py-3 font-medium"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @maintenance_windows.each do |maintenance_window| %>
        <tr>
          <td class="px-4 py-4 font-medium text-gray-900"><%= local_time_tag(maintenance_window.starts_at) %></td>
          <td class="px-4 py-4">
            <% if maintenance_window.upcoming? %>
              <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">Upcoming</span>
            <% else %>
              <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">Past</span>
            <% end %>
          </td>
          <td class="px-4 py-4 text-gray-700 max-w-xs truncate"><%= maintenance_window.note %></td>
          <td class="px-4 py-4">
            <div class="flex items-center gap-3">
              <%= link_to "Edit", edit_admin_maintenance_window_path(maintenance_window), class: "text-blue-600 hover:underline text-sm" %>
              <%= button_to "Delete", admin_maintenance_window_path(maintenance_window), method: :delete,
                    class: "text-red-600 hover:underline text-sm cursor-pointer",
                    data: { turbo_confirm: "Delete this maintenance window?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @maintenance_windows.empty? %>
    <p class="p-6 text-gray-600">No maintenance windows scheduled.</p>
  <% end %>
</div>
