<% content_for :title, "Admin workshops" %>
<% content_for :heading, "🔒 Workshops" %>
<% content_for :subtitle, "Upcoming workshops are listed on the announcements page, and the next one is bannered on the homepage." %>
<% content_for :actions do %>
  <%= link_to "New workshop", new_admin_workshop_path, class: "#{button_classes(color: "blue")} px-3.5 py-2" %>
  <%= link_to "Back to dashboard", admin_root_path, class: "#{button_classes(color: "gray")} px-3.5 py-2" %>
<% end %>

<div class="mt-6 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-600">
        <th class="px-4 py-3 font-medium">Title</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Starts</th>
        <th class="px-4 py-3 font-medium">Sign-up link</th>
        <th class="px-4 py-3 font-medium"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @workshops.each do |workshop| %>
        <tr>
          <td class="px-4 py-4 font-medium text-gray-900"><%= workshop.title %></td>
          <td class="px-4 py-4">
            <% if workshop.upcoming? %>
              <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">Upcoming</span>
            <% else %>
              <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">Past</span>
            <% end %>
          </td>
          <td class="px-4 py-4 text-gray-700"><%= local_time_tag(workshop.start_time) %></td>
          <td class="px-4 py-4 text-gray-700 max-w-xs truncate">
            <%= link_to workshop.link, workshop.link, class: "text-blue-600 hover:underline", target: "_blank", rel: "noopener" %>
          </td>
          <td class="px-4 py-4">
            <div class="flex items-center gap-3">
              <%= link_to "Edit", edit_admin_workshop_path(workshop), class: "text-blue-600 hover:underline text-sm" %>
              <%= button_to "Delete", admin_workshop_path(workshop), method: :delete,
                    class: "text-red-600 hover:underline text-sm cursor-pointer",
                    data: { turbo_confirm: "Delete this workshop?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @workshops.empty? %>
    <p class="p-6 text-gray-600">No workshops yet.</p>
  <% end %>
</div>
