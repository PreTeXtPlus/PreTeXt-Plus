<%= form_with model: [:admin, workshop], class: "space-y-6" do |form| %>
  <% if workshop.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 text-sm">
      <ul class="list-disc pl-4 space-y-1">
        <% workshop.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm", placeholder: "Workshop title" %>
  </div>

  <div>
    <%= form.label :start_time, class: "block text-sm font-medium text-gray-700" %>
    <p class="mt-1 text-xs text-gray-500">In your time zone (<%= Time.zone.name %>); visitors see it in theirs.</p>
    <%= form.datetime_field :start_time, class: "mt-2 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= form.label :link, "Sign-up link", class: "block text-sm font-medium text-gray-700" %>
    <%= form.url_field :link, class: "mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm", placeholder: "https://" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.check_box :free, class: "h-4 w-4 rounded border-gray-300 text-blue-600" %>
    <%= form.label :free, class: "text-sm font-medium text-gray-700" do %>
      Free workshop
      <span class="pl-2 text-xs text-gray-500 font-normal">
        The homepage banner labels it "free".
      </span>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= form.submit class: "#{button_classes(color: "blue")} px-3.5 py-2" %>
    <%= link_to "Cancel", admin_workshops_path, class: "#{button_classes(color: "gray")} px-3.5 py-2" %>
  </div>
<% end %>
