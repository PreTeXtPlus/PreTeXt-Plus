<%# The publisher-options modal, for whichever of the three levels `settings.owner` is.
    One partial for all of them: the levels differ in what they offer (an output shows only
    the tabs its own format reaches) and in what the empty choice inherits, both of which
    Publication::Settings has already worked out.

    z-40 rather than the drawer's z-30, because an output's settings open from inside the
    drawer and have to sit above it. %>
<div data-controller="modal" class="fixed inset-0 z-40 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-gray-900/40" data-action="click->modal#close"></div>

  <div role="dialog" aria-modal="true" aria-labelledby="publication-settings-title"
       class="relative flex max-h-full w-full max-w-2xl flex-col overflow-y-auto rounded-lg bg-white shadow-xl">

    <div class="flex items-start justify-between gap-4 border-b border-gray-200 p-5">
      <div>
        <h2 id="publication-settings-title" class="text-lg font-semibold">
          <%= publication_settings_title(settings.owner) %>
        </h2>
        <p class="mt-1 text-xs text-gray-500"><%= publication_settings_scope_note(settings.owner) %></p>
      </div>
      <button type="button" data-action="modal#close" aria-label="Close"
              class="cursor-pointer rounded-md px-2.5 py-1.5 text-sm text-gray-500 hover:bg-gray-100">✕</button>
    </div>

    <% view = local_assigns.fetch(:view, "settings") %>
    <% refused = local_assigns.fetch(:refused, []) %>
    <% families = settings.families %>
    <%# What the two views have in common. Both submit to the same place, and both carry
        this level's XML -- the XML view as the text being edited, the settings view as a
        hidden copy, so that work done in one view and not yet saved survives a visit to
        the other (see PublicationSettingsController#switch), and so that a save can tell
        which fields the author changed.

        _top for the reason the drawer's own forms use it: the redirect carries a flash,
        which this frame would otherwise swallow along with the reopened drawer. The
        buttons that switch views aim back at the frame instead.

        publication-xml checks the XML view's text before the form submits, so a typo is
        reported here, beside what the author typed, rather than in a flash after the
        modal (and the text) is gone. See publication_xml_controller.js. %>
    <%= form_with url: publication_settings_path_for(settings.owner), method: :patch,
          scope: :publication_settings,
          data: { turbo_frame: "_top", controller: "publication-xml",
                  action: "submit->publication-xml#guard",
                  publication_xml_url_value: check_publication_settings_path_for(settings.owner) } do |form| %>
      <%# A value typed in the settings view that could not be carried into the other
          view. Said here because the view just changed under the author; the field is
          back to what it was. %>
      <% if refused.any? %>
        <ul role="alert" class="border-b border-amber-200 bg-amber-50 px-5 py-3 text-xs text-amber-800">
          <% refused.each do |option, value| %>
            <li><%= option.label %> is unchanged: “<%= value %>” is not <%= option.guidance %>.</li>
          <% end %>
        </ul>
      <% end %>

      <% if view == "xml" %>
        <%= render "publication_settings/xml", settings:, document: local_assigns[:document] %>
      <% else %>
        <%# The XML these fields were drawn from, so a save writes only the fields the
            author changed, onto whatever is stored by then -- a collaborator's save made
            while this was open is kept. Except when that XML holds an edit made in the
            XML view and not yet saved: then it goes as the level's XML, to be saved
            whole, as the XML view itself would save it. See
            HasPublicationSettings#apply_publication_changes. %>
        <% if settings.owner.publication_xml_changed? %>
          <%= hidden_field_tag "publication_xml", settings.owner.publication_xml, id: nil %>
        <% else %>
          <%= hidden_field_tag "publication_xml_base", settings.owner.publication_xml, id: nil %>
        <% end %>

        <%# The tabs live inside the form, not around it: panels are hidden rather than
            unmounted, so a change made on one tab saves along with a change made on
            another. %>
        <div data-controller="tabs">
          <%# One tab is not a choice, so an output that only one family reaches gets its
              panel and its note without a tab strip above them. Scrolls sideways rather
              than wrapping on a narrow window. %>
          <% if families.size > 1 %>
            <div role="tablist" aria-label="Output formats"
                 class="flex gap-1 overflow-x-auto border-b border-gray-200 px-5">
              <% families.each_with_index do |(family, _options), index| %>
                <button type="button" role="tab" id="publication-tab-<%= family.key %>"
                        aria-controls="publication-panel-<%= family.key %>"
                        aria-selected="<%= index.zero? %>" tabindex="<%= index.zero? ? 0 : -1 %>"
                        data-tabs-target="tab"
                        data-action="click->tabs#select keydown->tabs#navigate"
                        class="shrink-0 cursor-pointer border-b-2 border-transparent px-3 py-2 text-sm font-medium
                               text-gray-500 hover:text-gray-800
                               aria-selected:border-indigo-600 aria-selected:text-indigo-700">
                  <%= family.label %>
                </button>
              <% end %>
            </div>
          <% end %>

          <% families.each_with_index do |(family, options), index| %>
            <section role="tabpanel" id="publication-panel-<%= family.key %>"
                     aria-labelledby="publication-tab-<%= family.key %>"
                     data-tabs-target="panel" tabindex="0" <%= "hidden" unless index.zero? %>
                     class="p-5">
              <%# Which outputs this tab reaches. The question an author asks after a
                  setting appears not to have worked is which format it was for. %>
              <p class="text-xs text-gray-500"><%= family.note %></p>

              <%# Options and disclosures in one ordered list, because a group may belong
                  beside the option it elaborates rather than at the foot of the panel --
                  see Publication::Settings#sections. A group holds a long tail (eighteen
                  knowl switches, twenty exercise components) that would bury the settings
                  around it if it were laid out inline. %>
              <div class="mt-4 space-y-4">
                <% settings.sections(options).each do |section| %>
                  <% if section.group? %>
                    <%= render "publication_settings/group", group: section.group,
                          options: section.options, form:, settings: %>
                  <% else %>
                    <%= render "publication_settings/option", option: section.option,
                          form:, settings: %>
                  <% end %>
                <% end %>
              </div>
            </section>
          <% end %>

          <%# Nothing reaches this today -- General is never empty -- but a dialog with a
              heading, a Save button and nothing between them reads as a bug. %>
          <% if families.empty? %>
            <p class="p-5 text-sm text-gray-600">Nothing to set here yet.</p>
          <% end %>
        </div>
      <% end %>

      <div class="flex items-center gap-3 border-t border-gray-200 p-5">
        <%# The way to the other view. A submit, so the form's unsaved state goes along; to
            #switch rather than #update, and back into this frame rather than the page.
            formnovalidate, because a half-typed number is no reason to be kept here. %>
        <button type="submit" name="view" value="<%= view == "xml" ? "settings" : "xml" %>"
                formaction="<%= switch_publication_settings_path_for(settings.owner) %>" formnovalidate
                data-turbo-frame="modal"
                class="cursor-pointer rounded-md px-3 py-2 text-sm text-blue-600 hover:bg-gray-100">
          <%= view == "xml" ? "← Back to settings" : "Edit as XML" %>
        </button>
        <%# Switching views saves nothing, so say when there is something to save. %>
        <% if settings.owner.publication_xml_changed? %>
          <span class="text-xs text-amber-700">Unsaved changes</span>
        <% end %>

        <button type="button" data-action="modal#close"
                class="ml-auto cursor-pointer rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100">
          Cancel
        </button>
        <%= form.submit "Save settings", class: "#{button_classes(color: "indigo")} px-3 py-2 text-sm" %>
      </div>
    <% end %>

    <p class="border-t border-gray-200 px-5 py-4 text-xs text-gray-500">
      Changes apply the next time you build.
    </p>
  </div>
</div>
