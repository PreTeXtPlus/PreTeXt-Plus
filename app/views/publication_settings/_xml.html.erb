<%# The modal's XML view: this level's publication XML, which is what the settings view
    edits -- shown whole, and editable directly, for anything PreTeXt supports that the
    settings do not offer. See Publication::Document.

    It replaces the settings view rather than sitting beside it as a tab, and
    PublicationSettingsController#switch carries unsaved work between the two, so what is
    here is always what saving would store.

    A mistake here is a paragraph of typing, not a select, so the publication-xml
    controller (on the form) checks the text before letting the form save and keeps the
    author here if anything would be refused.

    `document` is the text as just submitted, when it was refused on the way out of this
    view: it is shown again as typed, with its problems, in place of the level's own.
    Locals: settings, document. %>
<% refused_text = local_assigns[:document] if local_assigns[:document]&.errors&.any? %>
<% document = refused_text || settings.own_document %>
<% text = refused_text ? params[:publication_xml] : settings.owner.publication_xml %>
<section id="publication-xml-view" class="p-5">
  <p class="text-xs text-gray-500">
    The publication-file XML behind these settings. <%= publication_xml_scope_note(settings.owner) %>
    Edit it here for anything PreTeXt supports that the settings don't offer; see the
    publication file reference in the
    <%= link_to "PreTeXt Guide", "https://pretextbook.org/doc/guide/html/",
          target: "_blank", rel: "noopener", class: "text-blue-600 hover:underline" %>.
  </p>

  <%= label_tag "publication_xml", "Publication XML", class: "mt-4 block text-sm font-medium text-gray-800" %>
  <%= text_area_tag "publication_xml", text,
        rows: 16, spellcheck: false, autocapitalize: "off", autocomplete: "off",
        placeholder: "<publication>\n  <latex font-size=\"11\">\n    <page right-alignment=\"ragged\"/>\n  </latex>\n</publication>",
        "aria-describedby": "publication-xml-issues",
        data: { publication_xml_target: "input", action: "input->publication-xml#edited" },
        class: "mt-1 w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 font-mono text-xs leading-5" %>

  <div class="mt-2 flex items-center gap-3">
    <button type="button" data-action="publication-xml#check"
            class="cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-800 hover:bg-gray-50">
      Check
    </button>
    <span data-publication-xml-target="status" role="status" class="text-xs text-gray-500"></span>
  </div>

  <ul id="publication-xml-issues" data-publication-xml-target="issues" class="mt-3 space-y-1 text-xs">
    <% if document %>
      <% document.errors.each do |issue| %>
        <li class="text-red-700"><%= issue %></li>
      <% end %>
      <% document.warnings.each do |issue| %>
        <li class="text-amber-700"><%= issue %></li>
      <% end %>
    <% end %>
  </ul>

  <p class="mt-3 text-xs text-gray-500">
    PreTeXt.Plus keeps control of where source, assets and generated files live and where a
    website loads PreTeXt's scripts from, so those parts of the file are ignored here.
  </p>

  <%# What a build at this level would be handed. The same builder a build uses, so there
      is nothing here that could disagree with it. %>
  <details class="mt-4 rounded-md border border-gray-200 bg-gray-50">
    <summary class="cursor-pointer rounded-md px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-100">
      Resulting publication file
    </summary>
    <pre data-publication-xml-target="preview"
         class="max-h-80 overflow-auto border-t border-gray-200 bg-white px-3 py-2 font-mono text-xs leading-5"><%= settings.file_preview %></pre>
  </details>
</section>
