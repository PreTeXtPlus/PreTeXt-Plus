<% content_for :title, @announcement.title %>
<% content_for :breadcrumb do %>
  <%= link_to "Announcements", announcements_path, class: "hover:underline" %> /
<% end %>
<% content_for :heading, @announcement.title %>
<% content_for :subtitle do %>
  <%= local_time_tag(@announcement.published_at, date_only: true) if @announcement.published_at %>
  <% if @announcement.paid_subscribers_only? %>
    &middot; <span class="text-amber-600 font-medium">Subscribers only</span>
  <% end %>
<% end %>

<div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
  <div class="mt-6 prose prose-gray max-w-none text-gray-800">
    <%= sanitize Commonmarker.to_html(@announcement.body) %>
  </div>
</div>
