<% content_for :title, "Announcements" %>
<% content_for :heading, "Announcements" %>
<% content_for :subtitle, "News and updates from the PreTeXt.Plus team." %>
<% if can? :manage, Announcement %>
  <% content_for :actions do %>
    <%= link_to "Admin", admin_announcements_path,
          class: "#{button_classes(color: "sky")} px-3.5 py-2" %>
    <%= link_to "Manage workshops", admin_workshops_path,
          class: "#{button_classes(color: "sky")} px-3.5 py-2" %>
  <% end %>
<% end %>

<% if @upcoming_workshops.any? %>
  <section class="mt-8">
    <h2 class="text-2xl font-semibold text-gray-900">Upcoming workshops</h2>
    <div class="mt-4 space-y-4">
      <% @upcoming_workshops.each do |workshop| %>
        <div class="rounded-xl border border-purple-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-900"><%= workshop.title %></h3>
              <p class="mt-1 text-sm text-gray-500"><%= local_time_tag(workshop.start_time) %></p>
            </div>
            <%= link_to "Sign up", workshop.link, target: "_blank", rel: "noopener",
                  class: "#{button_classes(color: "purple")} px-3.5 py-2" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @announcements.any? %>
  <div class="mt-8 space-y-4">
    <% @announcements.each do |announcement| %>
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">
              <%= link_to announcement.title, announcement_path(announcement), class: "hover:underline" %>
            </h2>
            <p class="mt-1 text-sm text-gray-500">
              <%= local_time_tag(announcement.published_at, date_only: true) %>
              <% if announcement.paid_subscribers_only? %>
                &middot; <span class="text-amber-600 font-medium">Subscribers only</span>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="mt-8 text-gray-600">No announcements yet.</p>
<% end %>
