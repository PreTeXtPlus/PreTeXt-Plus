<% content_for :title, "Subscription types" %>
<% content_for :heading, "Subscription types" %>
<% content_for :actions do %>
  <%= link_to "New subscription type", new_subscription_type_path, class: "#{button_classes(color: "blue")} px-3.5 py-2.5 block" %>
<% end %>

<div id="subscription_types" class="min-w-full divide-y divide-gray-200 space-y-5">
  <% if @subscription_types.any? %>
    <% @subscription_types.each do |subscription_type| %>
      <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
        <%= render subscription_type %>
        <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
          <%= link_to "Show", subscription_type, class: "#{button_classes(color: "gray")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
          <%= link_to "Edit", edit_subscription_type_path(subscription_type), class: "#{button_classes(color: "gray")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
          <%= button_to "Destroy", subscription_type, method: :delete, class: "#{button_classes(color: "red")} w-full sm:w-auto px-3.5 py-2.5", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-center my-10">No subscription types found.</p>
  <% end %>
</div>
