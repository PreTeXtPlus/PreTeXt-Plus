<% content_for :title, "Showing subscription type" %>
<% content_for :heading, "Showing subscription type" %>

<%= render @subscription_type %>

<%= link_to "Edit this subscription type", edit_subscription_type_path(@subscription_type), class: "#{button_classes(color: "gray")} w-full sm:w-auto text-center px-3.5 py-2.5 inline-block" %>
<%= link_to "Back to subscription types", subscription_types_path, class: "#{button_classes(color: "gray")} w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 px-3.5 py-2.5 inline-block" %>
<%= button_to "Destroy this subscription type", @subscription_type, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "#{button_classes(color: "red")} w-full px-3.5 py-2.5", data: { turbo_confirm: "Are you sure?" } %>
