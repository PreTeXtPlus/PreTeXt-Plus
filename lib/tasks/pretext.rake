# Refreshes the list of journals PreTeXt can typeset an article for.
#
# PreTeXt keeps one source of truth for these -- journals/journals.xml in the PreTeXt
# repository -- and its build script reads that file to turn a publication file's
# <journal name="..."/> into the texstyle that styles the LaTeX (see get_journal_info in
# pretext/lib/pretext.py upstream). Transcribing the list here by hand would mean a picker
# that silently falls behind the journals that actually build, so this fetches it instead
# and writes the two fields the picker needs to config/pretext_journals.yml, which
# Publication::Catalog loads.
#
# Run it when bumping @pretextbook/pretext-html: that package pins which PreTeXt the app's
# XSL comes from, and this reads the same pin (assets/upstream.json), so the journals we
# offer stay the journals that PreTeXt knows. Deliberately not wired into `npm run build`
# -- that runs in watch mode all through development, and a picker should not go blank
# because a laptop was offline.
namespace :pretext do
  desc "Refresh config/pretext_journals.yml from PreTeXt's own journals.xml"
  task :journals do
    require "json"
    require "net/http"
    require "nokogiri"
    require "yaml"

    pin_path = Rails.root.join("node_modules/@pretextbook/pretext-html/assets/upstream.json")
    list_path = Rails.root.join("config/pretext_journals.yml")

    abort "#{pin_path} is missing -- run `npm install` first." unless pin_path.exist?

    repository, ref = JSON.parse(pin_path.read).fetch("source").values_at("repository", "ref")
    url = "https://raw.githubusercontent.com/#{repository}/#{ref}/journals/journals.xml"

    puts "Fetching #{url}"
    response = Net::HTTP.get_response(URI(url))
    abort "#{url} returned #{response.code} #{response.message}." unless response.is_a?(Net::HTTPSuccess)

    # Which entries stand for a publisher's whole family rather than one serial. PreTeXt
    # does not record this: its own table of journals is flat, and journals.xml carries a
    # TODO about categorising them, so the split is ours to keep and to maintain here.
    #
    # Everything unlisted is taken to be an individual journal, which all but a handful
    # are. That is the safe way round -- a family mis-filed as a journal is a picker in a
    # slightly odd order, while a journal mis-filed as a family tells an author that
    # choosing it covers a publisher it does not.
    publisher_wide = %w[ ams elsevier springer-nature taylor-francis ]

    journals = Nokogiri::XML(response.body).xpath("/ptx-journals/journal").map do |journal|
      entry = %w[ code name ].index_with { |field| journal.at_xpath(field)&.text.to_s.strip }
      entry.merge("group" => publisher_wide.include?(entry["code"]) ? "publisher" : "journal")
    end.sort_by { |journal| [ journal["group"] == "publisher" ? 0 : 1, journal["name"].downcase ] }

    # Three ways a fetch can "succeed" and still be worthless: a redirect to an HTML error
    # page, a file moved out from under us, and an upstream edit that mangles an entry.
    # Any of them would quietly empty or corrupt a picker that an author then cannot use,
    # so none of them gets written.
    abort "No journals found at #{url} -- has the file moved?" if journals.empty?

    # A code is written straight into a publication file as an attribute value, and a name
    # is shown to an author. Neither is ours to sanitize after the fact.
    journals.each do |journal|
      abort "Unusable journal entry: #{journal.inspect}" unless
        journal["code"].match?(/\A[a-z0-9-]+\z/) && journal["name"].present?
    end

    previous = (YAML.load_file(list_path) if list_path.exist?) || []
    added = journals.map { |j| j["code"] } - previous.map { |j| j["code"] }
    removed = previous.map { |j| j["code"] } - journals.map { |j| j["code"] }

    list_path.write(<<~HEADER + journals.to_yaml)
      # Generated by `bin/rails pretext:journals` -- do not edit by hand.
      #
      # The journals PreTeXt ships a LaTeX style for, read from journals/journals.xml in
      # #{repository}@#{ref}, which is PreTeXt's own source of truth for them. `code` is
      # what a publication file carries as <journal name="..."/>; `name` is what the build
      # settings picker shows; `group` is "publisher" for a style covering a publisher's
      # whole family and "journal" for one serial, which is how the picker breaks the list
      # up. Refreshed #{Date.today}.
    HEADER

    puts "Wrote #{journals.size} journals to #{list_path.relative_path_from(Rails.root)}"
    puts "  added:   #{added.join(', ')}" if added.any?
    puts "  removed: #{removed.join(', ')}" if removed.any?
    puts "  unchanged" if added.empty? && removed.empty?

    # Upstream names a family "<Publisher> journals", so an entry named that way and not
    # listed above is very likely one filed under the wrong heading. Said rather than
    # obeyed: `publisher_wide` is what decides, because a name is a convention and not a
    # contract, and a silent reclassification is the thing this task exists to avoid.
    journals.each do |journal|
      next unless journal["name"].match?(/journals\z/i) && journal["group"] == "journal"

      puts "  note: #{journal['code']} is named like a publisher-wide style but is filed " \
           "as one journal -- add it to publisher_wide in lib/tasks/pretext.rake if it covers a publisher."
    end
  end
end

# Refreshes config/pretext_publication_schema.yml: every element and attribute PreTeXt's
# XSL reads from a publication file, with the values it accepts where it says.
#
# This is what the build settings' Advanced tab checks hand-written XML against -- not to
# refuse anything (an author on a newer PreTeXt than ours should not be locked out of an
# option we have not heard of), but to warn about a likely typo before a build quietly
# falls back to PreTeXt's default. See Publication::Schema.
#
# Two sources, both in the XSL the app already pins (@pretextbook/pretext-html):
#
#   - the <pi:publisher> table in publisher-variables.xsl, PreTeXt's own machine-readable
#     list of publication attributes with their defaults and permitted values;
#   - every literal `$publication/...` path in the stylesheets, which catches what the
#     table does not list -- latex/page/geometry, latex/cover/@front, html/css/@theme and
#     the rest that the XSL reads directly;
#   - the html-theme-option-list in publisher-variables.xsl, for the html/css attributes
#     each HTML theme reads by name (palette, primary-color, color-main, ...).
#
# Run it alongside pretext:journals when bumping @pretextbook/pretext-html.
namespace :pretext do
  desc "Refresh config/pretext_publication_schema.yml from PreTeXt's XSL"
  task :publication_schema do
    require "nokogiri"
    require "yaml"

    xsl_dir = Rails.root.join("node_modules/@pretextbook/pretext-html/assets/xsl")
    variables = xsl_dir.join("publisher-variables.xsl")
    schema_path = Rails.root.join("config/pretext_publication_schema.yml")

    abort "#{variables} is missing -- run `npm install` first." unless variables.exist?

    # path ("latex/page") => attribute name => { "default", "options" }. A path with no
    # attributes is still worth recording: it is an element PreTeXt looks for.
    paths = Hash.new { |hash, key| hash[key] = {} }

    doc = Nokogiri::XML(variables.read)
    table = doc.at_xpath("//pi:publisher", "pi" => "http://pretextbook.org/2020/pretext/internal")
    abort "No <pi:publisher> table in #{variables} -- has it moved?" if table.nil?

    table.xpath(".//*[local-name()='pub-attribute']").each do |attribute|
      path = attribute.ancestors.take_while { |node| node != table }.reverse.map(&:name).join("/")
      options = [ attribute["default"], *attribute["options"].to_s.split ].compact.reject(&:empty?)
      entry = {}
      entry["default"] = attribute["default"] if attribute["default"]
      # A freeform attribute takes any value; one with no options listed is the same thing
      # as far as a warning is concerned.
      entry["options"] = options.uniq if attribute["freeform"] != "yes" && options.any?
      paths[path][attribute["name"]] = entry
      # The legacy spelling still works, so it is not a typo.
      paths[path][attribute["legacy-name"]] = entry.deep_dup if attribute["legacy-name"]
    end

    # Theme options on html/css: palette, primary-color, color-main and the rest. PreTeXt
    # reads these by name through get-theme-option, so the literal-path scan below never
    # sees them; html-theme-option-list is where it says which theme takes which.
    #
    # Recorded twice. The union goes on html/css, with no values -- a palette name or a CSS
    # color is the theme's business -- since an option some theme reads is not a typo. And
    # each theme's own list goes under `themes`, because one theme ignores another's
    # options (default-modern takes primary-color, denver takes color-main), which is the
    # mistake an author switching themes makes. See Publication::Document.
    theme_list = doc.at_xpath("//xsl:variable[@name='html-theme-option-list']",
                              "xsl" => "http://www.w3.org/1999/XSL/Transform")
    abort "No html-theme-option-list in #{variables} -- has it moved?" if theme_list.nil?

    themes = theme_list.xpath(".//*[local-name()='theme']").to_h do |theme|
      [ theme["name"], theme.xpath("./*[local-name()='option']").map { |option| option["name"] }.sort ]
    end
    abort "Found no themes in html-theme-option-list -- has it changed shape?" if themes.empty?

    themes.values.flatten.each { |name| paths["html/css"][name] ||= {} }

    # Literal paths only. A path built from a variable or a predicate stops at the first
    # character that is not part of a plain step, which records its known prefix and
    # nothing invented.
    Dir[xsl_dir.join("**/*.xsl")].each do |file|
      File.read(file).scan(%r{\$publication((?:/@?[A-Za-z][\w.-]*)+)}).each do |(steps)|
        parts = steps.delete_prefix("/").split("/")
        attribute = parts.last.start_with?("@") ? parts.pop.delete_prefix("@") : nil
        parts.each_index { |i| paths[parts[0..i].join("/")] }
        paths[parts.join("/")][attribute] ||= {} if attribute && parts.any?
      end
    end

    abort "Found suspiciously few publication paths (#{paths.size}) -- has the XSL changed shape?" if paths.size < 40

    sorted = paths.sort.to_h.transform_values { |attributes| attributes.sort.to_h }
    schema_path.write(<<~HEADER + { "paths" => sorted, "themes" => themes }.to_yaml)
      # Generated by `bin/rails pretext:publication_schema` -- do not edit by hand.
      #
      # Every element and attribute PreTeXt's XSL reads from a publication file, from the
      # <pi:publisher> table in publisher-variables.xsl and from literal $publication/...
      # paths across the stylesheets in @pretextbook/pretext-html. `options`, where present,
      # are the values PreTeXt accepts; anything else falls back to `default`. `themes` is
      # the html/css attributes each HTML theme reads, from html-theme-option-list. Used
      # only to warn about hand-written XML in the build settings -- see Publication::Schema.
      # Refreshed #{Date.today}.
    HEADER

    puts "Wrote #{sorted.size} paths, #{sorted.values.sum(&:size)} attributes, #{themes.size} themes to " \
         "#{schema_path.relative_path_from(Rails.root)}"
  end
end
