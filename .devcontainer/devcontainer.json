// For format details, see https://containers.dev/implementors/json_reference/.
// For config options, see the README at: https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "pretext_plus",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/devcontainers/features/node:1": {"version": "24.14.1"},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {"moby":false},
    "ghcr.io/rails/devcontainer/features/postgres-client": {},
    "ghcr.io/nullcoder/devcontainer-features/stripe-cli:1": {}
  },

  "containerEnv": {
    "CAPYBARA_SERVER_PORT": "45678",
    "SELENIUM_HOST": "selenium",
    "KAMAL_REGISTRY_PASSWORD": "$KAMAL_REGISTRY_PASSWORD",
    "DB_HOST": "postgres"
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // 5173 is the Vite dev server for packages/web-editor (npm run dev).
  "forwardPorts": [3000, 5432, 5173],

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        // "process" (real listening sockets only) instead of the default
        // output-scanning behavior, which regex-matches terminal text for
        // anything port-like. `bin/dev` streams Rails/Tailwind/esbuild logs
        // through foreman, so every browser refresh prints new request logs;
        // output-based scanning was misreading those lines as new candidate
        // ports and auto-forwarding them.
        "remote.autoForwardPortsSource": "process",
        // Ports we didn't ask for (a stray candidate from the process scan,
        // a sibling container from docker-outside-of-docker, etc.) should be
        // left alone rather than auto-forwarded and surfaced in the Ports
        // panel.
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        },
        "remote.portsAttributes": {
          "3000": { "label": "Rails server", "onAutoForward": "notify" },
          "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
          "5173": { "label": "Vite (web-editor demo)", "onAutoForward": "silent" }
        }
      }
    }
  },

  // Uncomment to connect as root instead. More info: https://containers.dev/implementors/json_reference/#remoteUser.
  // "remoteUser": "root",


  // Use 'postCreateCommand' to run commands after the container is created.
  // Installs Chromium plus its OS-level dependencies (via sudo apt-get) so
  // Playwright can drive a headless browser for screenshots/inspection of
  // rendered pages, e.g. from Claude Code.
  "postCreateCommand": "bin/setup --skip-server && npx playwright install --with-deps chromium"
}
